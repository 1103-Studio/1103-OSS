# ===========================================
# 1103-OSS 配置文件
# S3 兼容对象存储系统
# ===========================================
# 复制此文件为 .env 并修改配置
# cp .env.example .env
# ===========================================

# -----------------------------------------
# 服务器配置
# -----------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=9000
SERVER_ADMIN_PORT=9001

# API 端点（前端使用，留空自动生成）
API_ENDPOINT=

# CORS 允许的来源（逗号分隔，* 表示允许所有）
ALLOWED_ORIGINS=*

# -----------------------------------------
# 数据库配置
# -----------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=oss
DB_PASSWORD=oss_password
DB_NAME=oss
DB_SSLMODE=disable
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5

# -----------------------------------------
# Redis 配置（可选）
# -----------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------
# 存储配置
# -----------------------------------------
STORAGE_TYPE=local
STORAGE_PATH=/data/oss

# -----------------------------------------
# 认证配置
# -----------------------------------------
# 管理员账户
ROOT_USER=admin
ROOT_PASSWORD=admin123

# S3 访问凭证（留空自动生成）
INIT_ACCESS_KEY=
INIT_ACCESS_SECRET=

# TOKEN_EXPIRE_HOURS=24

# -----------------------------------------
# 日志配置
# -----------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
# LOG_FILE_PATH=/var/log/oss/server.log

# -----------------------------------------
# 限制配置
# -----------------------------------------
# MAX_OBJECT_SIZE=5368709120
# MAX_PART_SIZE=104857600
# MIN_PART_SIZE=5242880
# MAX_PARTS=10000
# RATE_LIMIT_PER_SECOND=1000

# -----------------------------------------
# 生产环境部署提示
# -----------------------------------------
# 1. 修改 ROOT_PASSWORD 为强密码
# 2. 设置安全的 DB_PASSWORD
# 3. 配置 ALLOWED_ORIGINS 为具体域名
# 4. 保管好自动生成的 INIT_ACCESS_KEY/SECRET
